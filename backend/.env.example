# ===========================================
# LLM（对话生成）— DeepSeek 或 OpenAI 兼容 API
# ===========================================
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 也可用 OPENAI_API_KEY / OPENAI_BASE_URL 作为回退
LLM_MODEL=deepseek-chat

# ===========================================
# Embedding（文档向量化与检索）
# ===========================================
EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# 示例（SiliconFlow）：EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# ===========================================
# 服务与安全
# ===========================================
PORT=8000
DEBUG=true
SECRET_KEY=change-me-use-long-random-string-min-32-chars
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ===========================================
# 数据库（不设 DATABASE_URL 时默认 SQLite）
# ===========================================
# docker compose up -d postgres 后取消注释：
# DATABASE_URL=postgresql+psycopg://docpaws:docpaws@127.0.0.1:5432/docpaws
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# PG 集成测试（默认 docpaws_test 库）：
# PG_TEST_DATABASE_URL=postgresql+psycopg://docpaws:docpaws@127.0.0.1:5432/docpaws_test

# ===========================================
# 数据目录（路径均相对 backend/）
# ===========================================
# 默认 SQLite、上传与索引落在 backend/data/
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
# Windows 下 FAISS 建议纯英文路径；Linux/macOS 可用 ./data/indexes
INDEX_DIR=./data/indexes

# ===========================================
# Redis / Celery（可选；索引异步任务需要）
# ===========================================
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CACHE_REDIS_URL=redis://127.0.0.1:6379/0
RETRIEVAL_CACHE_TTL_SECONDS=600

# 问答限流（默认关；生产护成本请显式打开）
CHAT_RATE_LIMIT_ENABLED=false
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_CONCURRENT_LIMIT=2
CHAT_CONCURRENT_TTL_SECONDS=600
# 拼进 prompt 的历史 token 预算（cl100k 粗估）；超了：近几轮原样 + 更早压缩，仍超再裁（0=不裁）
CHAT_HISTORY_MAX_TOKENS=2000
CHAT_HISTORY_RECENT_MESSAGES=4
CHAT_HISTORY_OLDER_LINE_TOKENS=40

# ===========================================
# 检索拒答（FAISS L2，越小越相似；0=仅空结果拒答）
# ===========================================
RETRIEVAL_MAX_DISTANCE=0

# ===========================================
# 检索重排 Rerank（默认关；CI 不依赖外网）
# ===========================================
RERANK_ENABLED=false
# 开启时：siliconflow（真云端）| fake（本地排序断言）| noop
RERANK_PROVIDER=siliconflow
# 可回退 EMBEDDING_API_KEY；模型必须是 rerank，勿复用 embedding 模型名
# RERANK_API_KEY=
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# 文本精排默认 Qwen/Qwen3-Reranker-8B（勿填 embedding 模型名；bge-v2-m3 易把主题噪声顶前）
# RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_RETRIEVE_K=20
# RERANK_TIMEOUT_SECONDS=10
# fake 用：含该子串的 chunk 顶前（例：RERANK_FAKE_BOOST_SUBSTRING=保修期）
# RERANK_FAKE_BOOST_SUBSTRING=

# ===========================================
# 索引任务超时（秒）
# ===========================================
INDEX_JOB_STALE_QUEUED_SECONDS=30
INDEX_JOB_STALE_RUNNING_SECONDS=30

# ===========================================
# MinIO / S3（上传 PDF 需要；可先 docker compose up -d 起 MinIO）
# ===========================================
S3_ENDPOINT_INTERNAL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=kb-files
